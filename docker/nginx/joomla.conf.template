upstream php_fpm {
	server php:9000;
	keepalive 16;
}

server {
	listen 80;
	server_name _;
	root ${DOCROOT};

	include /etc/nginx/snippets/common.conf;

	location = /configuration.php {
		return 404;
	}

	location ~ ^/(administrator/logs|administrator/cache|cache|tmp|logs|cli|libraries|installation)/ {
		return 403;
	}

	location ~* ^/images/.*\.php$ {
		return 403;
	}

	if ($query_string ~* "base64_encode[^(]*\([^)]*\)|(<|%3C)([^s]*s)+cript.*(>|%3E)|GLOBALS(=|\[|%[0-9A-Z]{0,2})|_REQUEST(=|\[|%[0-9A-Z]{0,2})") {
		return 403;
	}

	location ~* \.svg$ {
		add_header Content-Security-Policy "script-src 'none'" always;
		add_header X-Content-Type-Options nosniff always;
		expires max;
		try_files $uri =404;
	}

	location ~* \.(css|js|gif|ico|jpg|jpeg|png|webp|avif|woff|woff2|ttf|eot|otf)$ {
		expires max;
		log_not_found off;
		try_files $uri =404;
	}

	location /api/ {
		try_files $uri $uri/ /api/index.php?$args;
	}

	location / {
		try_files $uri $uri/ /index.php?$args;
	}

	location ~ \.php(/|$) {
		include /etc/nginx/snippets/php-fpm.conf;
	}
}
