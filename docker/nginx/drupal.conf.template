upstream php_fpm {
	server php:9000;
	keepalive 16;
}

server {
	listen 80;
	server_name _;
	root ${DOCROOT};

	include /etc/nginx/snippets/common.conf;

	location ~ \..*/.*\.php$ {
		return 403;
	}

	location ~ ^/sites/.*/private/ {
		return 403;
	}

	location ~ ^/sites/[^/]+/files/.*\.php$ {
		return 403;
	}

	location ~ /vendor/.*\.php$ {
		return 404;
	}

	location ~* \.(engine|inc|install|make|module|profile|po|sh|.*sql|theme|twig|tpl(\.php)?|xtmpl|yml)(~|\.sw[op]|\.bak|\.orig|\.save)?$|^(Entries.*|Repository|Root|Tag|Template|composer\.(json|lock)|web\.config)$|^#.*#$|\.php(~|\.sw[op]|\.bak|\.orig|\.save)$ {
		return 404;
	}

	location / {
		try_files $uri /index.php?$query_string;
	}

	location @rewrite {
		rewrite ^ /index.php;
	}

	location ~ ^/sites/.*/files/styles/ {
		try_files $uri @rewrite;
	}

	location ~ ^(/[a-z\-]+)?/system/files/ {
		try_files $uri /index.php?$query_string;
	}

	location ~* \.(css|js|gif|ico|jpg|jpeg|png|svg|webp|avif|woff|woff2|ttf|eot|otf)$ {
		try_files $uri @rewrite;
		expires max;
		log_not_found off;
	}

	location ~ '\.php$|^/update\.php' {
		include /etc/nginx/snippets/php-fpm.conf;
	}

	if ($request_uri ~* "^(.*/)index\.php/(.*)") {
		return 307 $1$2;
	}
}
